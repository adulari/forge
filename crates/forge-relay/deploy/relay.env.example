FORGE_APNS_TEAM_ID=YOUR_TEAM_ID
FORGE_APNS_KEY_ID=YOUR_APNS_KEY_ID
FORGE_RELAY_BIND_ADDR=127.0.0.1
FORGE_RELAY_TRUST_PROXY_HEADERS=true
# Required privacy mode for the stock public relay. Private relays omit this (or set false) to
# preserve rich notification text.
FORGE_RELAY_GENERIC_ALERTS=true
PORT=8787
FORGE_RELAY_RATE_LIMIT=30
FORGE_RELAY_RATE_WINDOW_SECS=60
FORGE_RELAY_DAILY_SEND_CAP=50000

# --- Issue reports (POST /v1/reports) ---
# GitHub token of the forge-mesh bot (issues: write on the repo). Without it reports answer 503
# and the rest of the relay (APNs) is unaffected. Keep this file mode 0600; never commit a value.
FORGE_RELAY_GITHUB_TOKEN=
FORGE_RELAY_GITHUB_REPO=Adulari/forge
FORGE_RELAY_REPORTS_DB=/var/lib/forge-relay/reports.sqlite
# Kill switch: 1 makes the endpoint answer 503 + Retry-After (clients back off and keep reports queued).
FORGE_RELAY_REPORTS_DISABLED=0
FORGE_RELAY_REPORTS_PER_INSTALL_PER_HOUR=30
FORGE_RELAY_REPORTS_PER_IP_PER_HOUR=120
FORGE_RELAY_REPORTS_GLOBAL_PER_HOUR=600
# Minimum seconds between GitHub edits of one issue (bursts coalesce into one edit).
FORGE_RELAY_REPORTS_MIN_UPDATE_SECS=60
