server {
    server_name forge.adulari.dev;
    server_tokens off;

    root /var/www/forge.adulari.dev;
    index index.html;

    location = /docs {
        try_files /docs.html =404;
    }

    location = /relay/health {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8788/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    location /relay/ {
        # Legacy clients put an APNs token in the URL. Do not persist request paths here.
        access_log off;
        error_log /var/log/nginx/forge-relay-error.log crit;
        limit_except POST { deny all; }

        proxy_pass http://127.0.0.1:8788/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        client_max_body_size 4k;
    }

    # Keyless benchmark scores (ADR-0011). The benchmarks-mirror workflow publishes the document as
    # an asset of the rolling `benchmarks-data` GitHub release; this location serves it from the
    # site so clients have a first-party URL. GitHub answers the asset URL with a redirect, which
    # the named location follows server-side (clients see a plain 200 with an ETag-less or
    # GitHub-issued body; both work with their conditional requests). Nothing is stored on the
    # box. If this block is not deployed, clients fall back to the GitHub URL directly.
    location = /data/benchmarks.json {
        limit_except GET HEAD { deny all; }
        resolver 1.1.1.1 9.9.9.9 valid=300s ipv6=off;
        resolver_timeout 5s;
        set $benchmarks_origin https://github.com;
        proxy_pass $benchmarks_origin/adulari/forge/releases/download/benchmarks-data/benchmarks.json;
        proxy_ssl_server_name on;
        proxy_set_header Host github.com;
        proxy_set_header Cookie "";
        proxy_intercept_errors on;
        error_page 301 302 303 307 308 = @benchmarks_asset;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        expires 15m;
    }

    location @benchmarks_asset {
        resolver 1.1.1.1 9.9.9.9 valid=300s ipv6=off;
        resolver_timeout 5s;
        set $benchmarks_asset_url $upstream_http_location;
        proxy_pass $benchmarks_asset_url;
        proxy_ssl_server_name on;
        proxy_set_header Cookie "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        expires 15m;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location /assets/ {
        expires 7d;
        add_header Cache-Control "public";
    }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/forge.adulari.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/forge.adulari.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;
    server_name forge.adulari.dev;
    return 301 https://$host$request_uri;
}
