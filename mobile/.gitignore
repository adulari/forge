# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders — /android is regenerated by EAS for native Android CI.
# ios/ is committed as an Xcode Cloud bootstrap: Xcode Cloud needs a real
# .xcodeproj/.xcworkspace in the repo just to let you create a workflow at all.
# ci_scripts/ci_post_clone.sh regenerates it fresh from app.config on every real
# build, so the committed copy only has to be "good enough to exist" — see
# ios/ci_scripts/ci_post_clone.sh.
/android
google-service-account.json
ios/Pods/
ios/build/
ios/DerivedData/
ios/*.xcuserstate
ios/**/xcuserdata/

# @bacons/apple-targets writes these at prebuild time; hand-authored Swift files remain committed.
targets/*/Info.plist
ios/.targets/
targets/*/Assets.xcassets
# ...except the widget's, which is hand-owned: it carries UIAppFonts so the extension
# bundle can resolve Geist/Geist Mono (the plugin only writes an Info.plist when none
# exists, and its README declares this file unmanaged). See targets/widget/Info.plist.
!targets/widget/Info.plist

# Tauri (mobile/src-tauri/)
src-tauri/target/
src-tauri/gen/
