+_RESPONSES_OUTPUT_TEXT_PART_TYPES = ("input_text", "output_text", "text")
+
+
+def _responses_output_slot(output: Any) -> tuple[str, tuple[str, int | None]] | None:
+    """Locate the compressible text of a Responses tool-output item.
+
+    Older clients send ``output`` as a plain string. Codex (0.15x, WebSocket transport) sends
+    ``custom_tool_call_output``/``function_call_output`` with ``output`` as a LIST of content
+    parts — ``[{"type": "input_text", "text": "..."}]``. Only the string form was recognised, so
+    every Codex tool result was classed ``output_type_without_text_slot`` and no Codex frame ever
+    produced a compression unit (``codex_ws.units_total == 0`` while ``frames_attempted`` grew).
+    An all-text part list is addressed as ``("output_parts", 0)``: the parts are joined for the
+    compressor and the replacement lands in the first part (the others are emptied).
+    """
+    if isinstance(output, str):
+        return output, ("output", None)
+    if isinstance(output, list) and output:
+        # Codex splits one tool result into several text parts (a status header such as
+        # "Script completed / Wall time …" followed by the body). Only an all-text list is
+        # addressed: the parts are joined for compression and the replacement is written back
+        # into the first part with the rest emptied, so the item keeps its shape. A list with
+        # any non-text part (an image, an unknown modality) is left alone.
+        if all(
+            isinstance(part, dict)
+            and part.get("type") in _RESPONSES_OUTPUT_TEXT_PART_TYPES
+            and isinstance(part.get("text"), str)
+            for part in output
+        ):
+            return "\n".join(part["text"] for part in output), ("output_parts", 0)
+    return None
+
